<?xml version="1.0" encoding="UTF-8"?>
<!-- equipment by vehicle category, encoded in the SUMO vehicle id (flow id) -->
<services>
    <service type="artery.application.CaService" name="CA">
        <listener port="2001" />
        <filters>
            <name pattern="coop_.*" />
        </filters>
    </service>
    <service type="artery.mcm.McService" name="MCS">
        <listener port="2050" />
        <filters>
            <name pattern="coop_.*" />
        </filters>
    </service>
</services>
