<?xml version="1.0" encoding="UTF-8"?>
<!-- Mixed traffic on a two-lane motorway: few lanes and spread speeds cause many
     lane changes, slow trucks are overtaken.
     The vehicle category is encoded in the flow id, services.xml equips by it:
       coop_*     automated, connected, cooperative (McService)
       noncoop_*  automated, connected, never yields (NonCooperativeMcService)
       manual_*   human driven, not connected; lane changes by SUMO's model
       truck_*    human driven trucks at 80 km/h, not connected
     Rates are those of density 1.0; omnetpp.ini scales them with SUMO's scale option. -->
<routes>
    <!-- automated: no driver imperfection; maxSpeedLat and lcAccelLat only bound the lateral
         movement commanded by McService (quintic, 3.5 m in 3 s: at most 2.2 m/s and 2.2 m/s^2);
         they are set well above, so that SUMO follows the commanded profile exactly -->
    <vType id="auto" vClass="passenger" length="5" width="1.8" minGap="2.5" maxSpeed="45"
           accel="2.6" decel="4.5" sigma="0" tau="1.0"
           speedFactor="normc(1,0.15,0.7,1.3)"
           lcStrategic="1" lcCooperative="1" lcSpeedGain="1" lcKeepRight="1"
           latAlignment="center" maxSpeedLat="8" lcAccelLat="60"
           color="0,0.67,0"/>
    <vType id="autoNonCoop" vClass="passenger" length="5" width="1.8" minGap="2.5" maxSpeed="45"
           accel="2.6" decel="4.5" sigma="0" tau="1.0"
           speedFactor="normc(1,0.15,0.7,1.3)"
           lcStrategic="1" lcCooperative="1" lcSpeedGain="1" lcKeepRight="1"
           latAlignment="center" maxSpeedLat="8" lcAccelLat="60"
           color="0.9,0.6,0"/>
    <!-- human drivers: imperfect car following, lane changes of SUMO's sublane model
         with about 1 m/s lateral speed -->
    <vType id="manual" vClass="passenger" length="5" width="1.8" minGap="2.5" maxSpeed="45"
           accel="2.6" decel="4.5" sigma="0.5" tau="1.2"
           speedFactor="normc(1,0.15,0.7,1.3)"
           latAlignment="center" maxSpeedLat="1.0"
           color="0.8,0.1,0.1"/>
    <vType id="truck" vClass="trailer" length="16" width="2.5" minGap="3" maxSpeed="22.22"
           accel="1.0" decel="4.0" sigma="0.5" tau="1.2"
           speedFactor="normc(1,0.03,0.95,1.05)"
           lcSpeedGain="0.2" lcKeepRight="1"
           latAlignment="center" maxSpeedLat="0.8"
           guiShape="truck" color="0.6,0.6,0.6"/>

    <route id="main" edges="hw0 hwAcc hw1"/>
    <route id="onRamp" edges="ramp hwAcc hw1"/>

    <!-- exponentially distributed headways (Poisson arrivals), rates in vehicles per second -->
    <flow id="coop_main" type="auto" route="main" begin="0" end="600"
          period="exp(0.3)" departLane="random" departSpeed="desired"/>
    <flow id="noncoop_main" type="autoNonCoop" route="main" begin="0" end="600"
          period="exp(0.0833)" departLane="random" departSpeed="desired"/>
    <flow id="manual_main" type="manual" route="main" begin="0" end="600"
          period="exp(0.1667)" departLane="random" departSpeed="desired"/>
    <flow id="truck_main" type="truck" route="main" begin="0" end="600"
          period="exp(0.0833)" departLane="0" departSpeed="desired"/>

    <flow id="coop_ramp" type="auto" route="onRamp" begin="0" end="600"
          period="exp(0.05)" departLane="0" departSpeed="desired"/>
    <flow id="noncoop_ramp" type="autoNonCoop" route="onRamp" begin="0" end="600"
          period="exp(0.0139)" departLane="0" departSpeed="desired"/>
    <flow id="manual_ramp" type="manual" route="onRamp" begin="0" end="600"
          period="exp(0.0278)" departLane="0" departSpeed="desired"/>
    <flow id="truck_ramp" type="truck" route="onRamp" begin="0" end="600"
          period="exp(0.0139)" departLane="0" departSpeed="desired"/>
</routes>
